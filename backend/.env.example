# ==============================================================================
# Sovereign AI Workbench — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored. This file (.env.example) is safe to commit.
# ==============================================================================

# ------------------------------------------------------------------------------
# Ollama Inference Service
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434

# Orchestrator / Reasoning / RAG / Data Agent
# Options: phi3:mini (faster, CPU-friendly) | llama3:8b (more capable)
OLLAMA_MODEL=llama3:8b
OLLAMA_TEXT_MODEL=llama3:8b

# Visual Agent (multimodal vision model)
# Options: llava:7b (more capable) | moondream:latest (ultra-lightweight 1.7B)
OLLAMA_VISION_MODEL=llava:7b

# ------------------------------------------------------------------------------
# Admin Portal Authentication (Basic Auth)
# Set a strong password — this gates the /admin route
# ------------------------------------------------------------------------------
ADMIN_PASSWORD=changeme

# ------------------------------------------------------------------------------
# App Config
# ------------------------------------------------------------------------------
APP_ENV=development
