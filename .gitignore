# ==============================================================================
# Sovereign AI Workbench (.gitignore)
# ==============================================================================

# Node.js & Frontend Dependencies
node_modules/
node_modules/**
**/node_modules/
**/node_modules/**
frontend/node_modules/
frontend/node_modules/**
.next/
.next/**
**/.next/
**/.next/**
out/
**/out/
.vercel
**/.vercel

# Python Virtual Environments & Packages
.venv
.venv/
.venv/**
**/.venv
**/.venv/
**/.venv/**
backend/.venv
backend/.venv/
backend/.venv/**
venv/
venv/**
**/venv/
**/venv/**
backend/venv/
backend/venv/**
env/
**/env/
*.egg-info/
**/*.egg-info/
dist/
build/

# Python Bytecode & Caches
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/

# Empty scaffold __init__.py files (not needed in Python 3.3+ namespace packages)
# If a module needs explicit __init__.py, add it deliberately with real content
**/__init__.py

# Local Databases, Vector Store & Uploads
data/
**/data/*
!**/data/.gitkeep
backend/data/
backend/data/*
!backend/data/.gitkeep
chroma/
**/chroma/
.chroma/
**/.chroma/
*.db
*.sqlite
*.sqlite3

# Environment Files & Secrets
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor & OS Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
**/.idea/
.vscode/
**/.vscode/
*.swp
*.swo
